  "bugs": {
    "url": "https://github.com/AlexDeveloperUwU/liberteis/issues"
  },
  "homepage": "https://github.com/AlexDeveloperUwU/liberteis#readme",
  "dependencies": {
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "generate-password": "^1.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "luxon": "^3.7.2",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.0.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-http-print": "^4.0.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "concurrently": "^9.2.4",
